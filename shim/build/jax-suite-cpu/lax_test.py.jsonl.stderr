      # composite decompositions with dynamic shapes (see #40486).
      @partial(lax.composite, name="my.square")
      def my_square(x):
        return x * x
    
      exp = export.export(jax.jit(my_square))(
          jax.ShapeDtypeStruct(export.symbolic_shape("b"), jnp.float32))
