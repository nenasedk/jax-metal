        elif dtype == np.complex64:
          c, d, e, tau, info = scipy.linalg.lapack.chetrd(a, lower=lower)
        elif dtype == np.complex128:
          c, d, e, tau, info = scipy.linalg.lapack.zhetrd(a, lower=lower)
