        y = lax.reduce_window(
            y, unit, op, (1, 2, 2, 1), (1, 1, 1, 1), 'SAME')
        return y
      grad_loss = grad(lambda params, x: jnp.mean(f(params, x) ** 2))
    
      # Test forward prop.
