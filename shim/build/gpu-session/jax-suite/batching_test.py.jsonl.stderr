    def testMinMaxPool(self, op, unit):
      W = jnp.array(self.rng().randn(3, 3, 1, 5), dtype=np.float32)
      X = jnp.array(self.rng().randn(10, 5, 5, 1), dtype=np.float32)
    
      def f(params, x):
