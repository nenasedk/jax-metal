    def testReduceWindowGrad(
        self, op, init_val, dtype, shape, dims, strides,
        padding, base_dilation, window_dilation, rng_factory):
      rng = rng_factory(self.rng())
      init_val = np.asarray(init_val, dtype=dtype)
    
      gradient_order = 3
