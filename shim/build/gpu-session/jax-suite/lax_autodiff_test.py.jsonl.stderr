      custom_float_dtypes = [
        _dtypes.float4_e2m1fn,
        _dtypes.float8_e8m0fnu,
        _dtypes.float8_e3m4,
        _dtypes.float8_e4m3,
        _dtypes.float8_e4m3b11fnuz,
        _dtypes.float8_e4m3fn,
        _dtypes.float8_e4m3fnuz,
        _dtypes.float8_e5m2,
        _dtypes.float8_e5m2fnuz,
        _dtypes.bfloat16,
      ]
    
      def maybe_upcast(x):
        if x.dtype in custom_float_dtypes:
