    def test_assert_discharging_cond(self):
      def true_branch(x):
        checkify.check(jnp.all(x != 0.), "x cannot be 0")
        return 1/x
    
      def false_branch(x):
        checkify.check(jnp.all(x >= 0), "x must be positive")
        return x*2
    
      @jax.jit
      def f(pred, x):
        return lax.cond(pred, true_branch, false_branch, x)
    
      checked_f = checkify.checkify(f)
    
