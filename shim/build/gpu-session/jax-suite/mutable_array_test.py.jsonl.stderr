    def test_dce_ref_write_in_one_cond_branch_read_in_other(self):
      def f(p, x):
        r = jax.new_ref(x)
        r[...] = x + 1.  # read by false_fun
        def true_fun():
          r[...] = x * 5.  # never read
          return 0.
        def false_fun():
          return r[...]
        return jax.lax.cond(p, true_fun, false_fun)
    
