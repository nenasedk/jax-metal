      np_op = get_np_op(name)
      jnp_op = get_jnp_op(name, use_method)
      rng = rng_factory(self.rng())
      is_bf16_nan_test = dtype == jnp.bfloat16
      # Do not pass where via args_maker as that is incompatible with _promote_like_jnp.
